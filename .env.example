# Copy to .env and adjust. Every value here is a fictional local default.

# Metadata database (PostgreSQL is the target; SQLite works for zero-infrastructure runs).
# PostgreSQL via docker compose:
#   METADATA_DATABASE_URL=postgresql+psycopg://txn_pipeline:txn_pipeline_dev_only@localhost:5432/txn_pipeline
METADATA_DATABASE_URL=sqlite:///./data/metadata/pipeline.db

# Where incoming / curated / quarantine / reports / warehouse data is written.
DATA_ROOT=./data

# Optional explicit DuckDB file (default: <DATA_ROOT>/warehouse/txn_warehouse.duckdb)
# WAREHOUSE_PATH=./data/warehouse/txn_warehouse.duckdb

# IANA timezone applied to timestamps WITHOUT an offset. Unset = such rows are quarantined (DQ009).
# SOURCE_TIMEZONE=Europe/London

# Quality thresholds
MIN_BOOKING_DATE=2000-01-01
MAX_BOOKING_DAYS_IN_FUTURE=1
VALUE_DATE_TOLERANCE_DAYS=5
TIMESTAMP_BOOKING_TOLERANCE_DAYS=1
FAIL_ON_WARNINGS=false
BUILD_WAREHOUSE_ON_RUN=true

# Who started the batch (CLI | SYSTEM | TEST). No authentication is implemented or implied.
ACTOR=CLI

# Logging: json or console
LOG_LEVEL=INFO
LOG_FORMAT=console
